{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": false,
    "outDir": "dist",
    "skipLibCheck": false
  },
  "include": [
    "offchain/**/*.ts",
    "offchain/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ]
}
