# Copy to the repository root as `.env.arbitrum-sepolia.local`, then `chmod 600`.
# The deployment CLI parses KEY=VALUE itself; this file is never sourced as shell code.

# `formal` requires clean signed audit tag, independent 4/6 + 2/6 Safes and two RPC origins.
# `debug` uses canonical testnet USDC. `sandbox` deploys unrestricted-mint ctUSD for the Web Demo.
# Neither debug nor sandbox can ever be labelled FINALIZED_VERIFIED.
CPREDICT_DEPLOYMENT_PROFILE=sandbox
CPREDICT_AUDIT_TAG=

ARBITRUM_SEPOLIA_RPC_URL_A=
ARBITRUM_SEPOLIA_RPC_URL_B=
ARBISCAN_API_KEY=

# 32-byte testnet-only deployer key. Never add a VITE_ prefix or commit the filled file.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_MIN_BALANCE_WEI=20000000000000000

GOVERNANCE_SAFE=
EMERGENCY_SAFE=
PROTOCOL_TREASURY=
SPONSOR_SIGNER=

# Deployment-time snapshot copied into every market. Production default is 86400; use 900 for
# an explicit 15-minute test deployment.
MARKET_RESOLUTION_WINDOW_SECONDS=86400

# Run `plan` first for independent review. Interactive debug deploy can use the fresh derived value.
EXPECTED_FACTORY_DEPENDENCY_FINGERPRINT=

PAYMASTER_MAX_COST_PER_OP=2000000000000000
PAYMASTER_MAX_COST_PER_USER_DAY=20000000000000000
PAYMASTER_MAX_COST_GLOBAL_DAY=500000000000000000

# Required only with --yes. Interactive confirmation does not use this variable.
CPREDICT_DEPLOYMENT_ACKNOWLEDGEMENT=ARBITRUM_SEPOLIA_TESTNET_ONLY
