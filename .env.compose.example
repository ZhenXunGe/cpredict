# Copy to .env.compose.local and chmod 600. The stack parser never sources this file.
# Values below are server-side only and must never use a VITE_ prefix.
ARBITRUM_SEPOLIA_RPC_URL=
CPREDICT_STACK_POSTGRES_ADMIN_PASSWORD=
CPREDICT_STACK_MIGRATOR_PASSWORD=
CPREDICT_STACK_INDEXER_PASSWORD=
CPREDICT_STACK_PAYMASTER_PASSWORD=
CPREDICT_STACK_METADATA_PASSWORD=
CPREDICT_STACK_BACKUP_PASSWORD=
CPREDICT_METADATA_PUBLIC_BASE_URL=https://101.32.241.211/metadata

# Generated public deployment configuration is read separately from this ignored runtime path.
CPREDICT_STACK_RUNTIME_ENV=runtime/arbitrum-sepolia/current.env
CPREDICT_STACK_DEMO_PORT=4177
CPREDICT_STACK_INDEXER_PORT=8787
CPREDICT_STACK_PAYMASTER_PORT=8791
CPREDICT_STACK_METADATA_PORT=8793
CPREDICT_STACK_RELAY_PORT=8792
# Optional canonical-header concurrency (1-32). Start at 4; verify the RPC before raising it.
CPREDICT_INDEXER_BLOCK_CONCURRENCY=4

# Optional `sponsorship` profile. The mounted module must provide Auth, KMS/HSM signing,
# a PostgreSQL budget store and account decoding. Raw private keys are not supported here.
CPREDICT_STACK_PAYMASTER_ADAPTER_HOST_PATH=

# Optional `relay` profile. The sender address must match the KMS/HSM adapter exactly.
# Generate the runtime package with deploy:sync -- ... --permit2-relay before starting it.
CPREDICT_STACK_RELAY_ADAPTER_HOST_PATH=
CPREDICT_RELAY_EXPECTED_SENDER=

# Optional --public-site upgrade: paths are read-only inputs, not copied into images.
# Provider env files must be 0600. Compose >= 2.30 is required for literal env_file values.
CPREDICT_STACK_CTUSD_APP_ENV_FILE=runtime/public-site/.env.cpredict-dev
CPREDICT_STACK_CTUSD_CONFIG_FILE=runtime/public-site/ctusd.runtime.json
CPREDICT_STACK_SITE_CONFIG_FILE=runtime/public-site/site-config.json
CPREDICT_STACK_APP_PORT=8795

# Optional --usdc: reuses PostgreSQL with independent databases and credentials.
CPREDICT_STACK_USDC_APP_ENV_FILE=runtime/public-site/.env.cpredict-prod
CPREDICT_STACK_USDC_CONFIG_FILE=runtime/public-site/usdc.runtime.json
CPREDICT_STACK_USDC_INDEXER_PASSWORD=
CPREDICT_STACK_USDC_METADATA_PASSWORD=
CPREDICT_STACK_USDC_INDEXER_PORT=8887
CPREDICT_STACK_USDC_METADATA_PORT=8893
CPREDICT_STACK_USDC_APP_PORT=8895
CPREDICT_USDC_INDEXER_BLOCK_CONCURRENCY=4
