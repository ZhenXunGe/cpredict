{
  "name": "cpredict-protocol",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "demo:validators": "node scripts/generate-web-demo-validators.mjs",
    "demo:validators:check": "node scripts/generate-web-demo-validators.mjs --check",
    "demo:dev": "npm run demo:validators:check && vite --config examples/web-demo/vite.config.ts",
    "demo:build": "npm run demo:validators:check && vite build --config examples/web-demo/vite.config.ts",
    "demo:preview": "npm run demo:validators:check && vite preview --config examples/web-demo/vite.config.ts",
    "demo:test": "vitest run examples/web-demo/test",
    "build:offchain": "tsc -p tsconfig.json",
    "start:paymaster-service": "node dist/offchain/paymaster-service/src/main.js",
    "start:metadata-service": "node dist/offchain/metadata-service/src/main.js",
    "check:offchain": "tsc -p tsconfig.json --noEmit",
    "test:offchain": "vitest run",
    "test:postgres": "node scripts/release/run-postgres-integration.mjs",
    "test": "npm run test:offchain",
    "generate:sbom": "node scripts/sbom/generate-sbom.mjs",
    "check:sbom": "node scripts/sbom/check-sbom.mjs",
    "test:sbom": "node --test scripts/sbom/sbom.test.mjs",
    "generate:artifacts": "npm run generate:sbom && node scripts/generate-artifacts.mjs",
    "check:artifacts": "npm run check:sbom && node scripts/check-generated.mjs",
    "check:requirements": "node scripts/check-requirements.mjs",
    "test:requirements": "node --test scripts/check-requirements.test.mjs",
    "test:release-tools": "node --test scripts/release/ci-attestation.test.mjs scripts/release/postgres-integration-runner.test.mjs scripts/release/release-bundle.test.mjs scripts/release/release-gates.test.mjs",
    "test:load-tools": "node --test scripts/load/validate-production-evidence.test.mjs load/distributed/chain-node-binding.test.mjs load/distributed/commercial-evidence.test.mjs load/distributed/preflight-role-evidence.test.mjs",
    "test:economics": "node --test scripts/economics/unit-economics.test.mjs scripts/economics/commercial-economics.test.mjs",
    "gate:commercial-economics": "node scripts/economics/run-commercial-economics-gate.mjs",
    "load:sut-up": "bash scripts/load/sut-up.sh",
    "load:run": "bash scripts/load/load-run.sh",
    "load:chain-run": "bash scripts/load/chain-run.sh",
    "load:collect-evidence": "bash scripts/load/evidence-collect.sh",
    "load:validate-commercial": "node load/distributed/commercial-evidence.mjs validate",
    "test:deployment-tools": "node --test scripts/deployment/*.test.mjs",
    "deploy:arbitrum-sepolia": "bash scripts/deployment/deploy-arbitrum-sepolia.sh",
    "deploy:sync": "node scripts/deployment/sync-runtime.mjs",
    "deploy:verify-source": "node scripts/deployment/verify-source.mjs",
    "canary:arbitrum-sepolia": "node scripts/deployment/canary-runner.mjs",
    "stack:config": "node scripts/stack/stack.mjs config",
    "stack:preflight": "node scripts/stack/host-preflight.mjs",
    "stack:proxy:render": "node scripts/stack/render-public-proxy.mjs",
    "stack:tunnel:render": "node scripts/stack/render-reverse-tunnel.mjs",
    "stack:up": "node scripts/stack/stack.mjs up",
    "stack:status": "node scripts/stack/stack.mjs status",
    "stack:verify": "node scripts/stack/verify-runtime.mjs",
    "stack:logs": "node scripts/stack/stack.mjs logs",
    "stack:down": "node scripts/stack/stack.mjs down",
    "stack:backup": "node scripts/stack/backup.mjs",
    "stack:backup:verified": "node scripts/stack/verified-backup.mjs",
    "stack:backup:prune": "node scripts/stack/prune-backups.mjs",
    "stack:backup:render-service": "node scripts/stack/render-backup-service.mjs",
    "stack:checkpoint": "node scripts/stack/upgrade-checkpoint.mjs",
    "stack:restore-drill": "node scripts/stack/restore-drill.mjs",
    "stack:drill": "node scripts/stack/ops-drill.mjs",
    "test:stack-tools": "node --test scripts/stack/*.test.mjs",
    "scan:demo-bundle": "node scripts/stack/scan-demo-bundle.mjs dist/web-demo",
    "build:release-bundle": "node scripts/release/build-release-bundle.mjs",
    "check:release-bundle": "node scripts/release/check-release-bundle.mjs",
    "check:release-gates": "node scripts/release/check-release-gates.mjs",
    "build:ci-attestation-predicate": "node scripts/release/build-ci-attestation-predicate.mjs",
    "verify:ci-attestation": "node scripts/release/verify-ci-attestation.mjs",
    "test:gate-parsers": "node --test scripts/normalize-text-log.test.mjs scripts/security/validate-gate-evidence.test.mjs scripts/security/scan-delivery-secrets.test.mjs scripts/security/write-gate-evidence.test.mjs scripts/security/parse-mutation-summary.test.mjs",
    "scan:secrets": "node scripts/security/scan-delivery-secrets.mjs",
    "scan:container-images": "bash scripts/security/scan-container-images.sh",
    "scan:container-config": ".tools/trivy/bin/trivy config --cache-dir .tools/trivy/cache --severity HIGH,CRITICAL --exit-code 1 --skip-check-update --skip-version-check --disable-telemetry deploy/compose",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.10.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.8",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
