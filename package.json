{
  "name": "cpredict-protocol",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "site:dev": "vite --config examples/user-site/vite.config.ts",
    "site:build": "npm run site:check && vite build --config examples/user-site/vite.config.ts",
    "postsite:build": "node scripts/public-site/package-notices.mjs",
    "site:measure:pc": "node scripts/public-site/measure-pc-build.mjs",
