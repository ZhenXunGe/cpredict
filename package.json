    "stack:proxy:render": "node scripts/stack/render-public-proxy.mjs",
    "stack:tunnel:render": "node scripts/stack/render-reverse-tunnel.mjs",
    "stack:up": "node scripts/stack/stack.mjs up",
    "stack:update:public": "node scripts/stack/public-update.mjs",
    "stack:publisher:prepare": "node scripts/stack/prepare-cloud-publisher.mjs",
    "stack:status": "node scripts/stack/stack.mjs status",
    "stack:verify": "node scripts/stack/verify-runtime.mjs",
    "stack:logs": "node scripts/stack/stack.mjs logs",
    "stack:down": "node scripts/stack/stack.mjs down",
    "stack:backup": "node scripts/stack/backup.mjs",
    "stack:backup:verified": "node scripts/stack/verified-backup.mjs",
    "stack:backup:prune": "node scripts/stack/prune-backups.mjs",
    "stack:backup:render-service": "node scripts/stack/render-backup-service.mjs",
    "stack:checkpoint": "node scripts/stack/upgrade-checkpoint.mjs",
    "stack:restore-drill": "node scripts/stack/restore-drill.mjs",
    "stack:drill": "node scripts/stack/ops-drill.mjs",
    "test:stack-tools": "node --test scripts/stack/*.test.mjs",
    "pretest:stack-tools": "npm run build:offchain",
    "scan:site-bundle": "node scripts/stack/scan-site-bundle.mjs dist/user-site",
    "build:release-bundle": "node scripts/release/build-release-bundle.mjs",
    "check:release-bundle": "node scripts/release/check-release-bundle.mjs",
    "check:release-gates": "node scripts/release/check-release-gates.mjs",
    "build:ci-attestation-predicate": "node scripts/release/build-ci-attestation-predicate.mjs",
    "verify:ci-attestation": "node scripts/release/verify-ci-attestation.mjs",
    "test:gate-parsers": "node --test scripts/normalize-text-log.test.mjs scripts/security/validate-gate-evidence.test.mjs scripts/security/scan-delivery-secrets.test.mjs scripts/security/write-gate-evidence.test.mjs scripts/security/parse-mutation-summary.test.mjs",
    "scan:secrets": "node scripts/security/scan-delivery-secrets.mjs",
    "scan:container-images": "bash scripts/security/scan-container-images.sh",
    "scan:container-config": ".tools/trivy/bin/trivy config --cache-dir .tools/trivy/cache --severity HIGH,CRITICAL --exit-code 1 --skip-check-update --skip-version-check --disable-telemetry deploy/compose",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
