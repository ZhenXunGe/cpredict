    "site:check": "npm run site:patches && tsc -p examples/user-site/tsconfig.json",
    "site:check:dependencies": "npm run site:patches && tsc -p examples/user-site/tsconfig.json --skipLibCheck false",
    "site:test:dependencies": "node --test scripts/public-site/dependency-compatibility.test.mjs",
    "site:test:patches": "npm run site:patches && node --test scripts/public-site/declaration-patches.test.mjs",
    "site:test:postgres": "node scripts/public-site/test-postgres.mjs",
    "site:test:entrypoints": "node scripts/stack/entrypoint-smoke.mjs",
    "presite:test:browser": "npm run site:build",
    "site:test:browser": "playwright test --config examples/user-site/test/browser/playwright.config.ts",
    "presite:test:capacity": "npm run build:offchain",
    "site:test:capacity": "node scripts/public-site/test-capacity.mjs",
