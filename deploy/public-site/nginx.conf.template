# Standalone static hosting alternative. The in-place Compose upgrade uses
# scripts/stack/render-public-proxy.mjs --public-site and its loopback gateway.
# Render only for an explicitly approved host; upstreams are operator config.
map $uri $cpredict_cache_control {
  default "no-store";
  ~^/(demo/)?assets/ "public, max-age=31536000, immutable";
}
server {
  listen 443 ssl;
  server_name ${PUBLIC_HOSTNAME};
  ssl_certificate ${TLS_CERTIFICATE};
  ssl_certificate_key ${TLS_PRIVATE_KEY};
  root ${USER_SITE_ROOT};
  index index.html;
  client_max_body_size 128k;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Host $host;
  proxy_set_header Authorization "";
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;
  add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
  # Does not block Privy child frames or wallet transport. Validate a stricter provider CSP in staging.
  add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'" always;
  add_header Cache-Control $cpredict_cache_control always;
  location = /site-config.json { try_files $uri =404; }
  location /assets/ { try_files $uri =404; }
  # Install demo:build:embedded output in USER_SITE_ROOT/demo before enabling.
  location = /demo { return 308 /demo/; }
  location /demo/assets/ { try_files $uri =404; }
  location /demo/ { try_files $uri $uri/ /demo/index.html; }
  location = /runtime-config.json { try_files $uri =404; }
  location /deployment/ { try_files $uri =404; }
  location /indexer/ { proxy_pass http://${CTUSD_INDEXER}/; }
  location /metadata/ { proxy_pass http://${CTUSD_METADATA}/; }
  # The existing loopback gateway retains its validated RPC/optional relay configuration.
  location = /rpc { limit_except POST { deny all; } proxy_pass http://${LEGACY_GATEWAY}; }
  location /relay/ { limit_except POST { deny all; } proxy_pass http://${LEGACY_GATEWAY}; }
  location ~ ^/(?:ctusd/|usdc/)?(?:app/|indexer/|metadata/)?(?:metrics|readyz)(?:/|$) { return 404; }
  location ~ ^/(?:runtime|\.env|\.git)(?:/|$|\.) { return 404; }
  location /ctusd/app/ {
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_pass http://${CTUSD_APP}/; proxy_read_timeout 20s;
  }
  location /ctusd/indexer/ { proxy_pass http://${CTUSD_INDEXER}/; proxy_read_timeout 60s; }
  location /ctusd/metadata/ { proxy_pass http://${CTUSD_METADATA}/; proxy_read_timeout 20s; }
  location /usdc/app/ {
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_pass http://${USDC_APP}/; proxy_read_timeout 20s;
  }
  location /usdc/indexer/ { proxy_pass http://${USDC_INDEXER}/; proxy_read_timeout 60s; }
  location /usdc/metadata/ { proxy_pass http://${USDC_METADATA}/; proxy_read_timeout 20s; }
  location = /recovery.html { try_files $uri =404; }
  location / { try_files $uri /index.html; }
}
