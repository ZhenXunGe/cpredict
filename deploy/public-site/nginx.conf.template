# Render only for an explicitly approved host. Each upstream belongs to a separate environment.
# TLS and upstream addresses are operator configuration, never browser configuration.
map $uri $cpredict_cache_control {
  default "no-store";
  ~^/assets/ "public, max-age=31536000, immutable";
}
server {
  listen 443 ssl;
  server_name ${PUBLIC_HOSTNAME};
  ssl_certificate ${TLS_CERTIFICATE};
  ssl_certificate_key ${TLS_PRIVATE_KEY};
  root ${USER_SITE_ROOT};
  index index.html;
  client_max_body_size 128k;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Host $host;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;
  # Does not block Privy child frames or wallet transport. Validate a stricter provider CSP in staging.
  add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'" always;
  add_header Cache-Control $cpredict_cache_control always;
  location = /site-config.json { try_files $uri =404; }
  location /assets/ { try_files $uri =404; }
  # Preserve the existing deployment origin: its root assets, runtime config and API paths stay together.
  location = /demo { return 302 ${LEGACY_DEMO_URL}; }
  location /demo/ { return 302 ${LEGACY_DEMO_URL}; }
  location ~ ^/(ctusd|usdc)/(app|indexer)/(metrics|readyz)$ { return 404; }
  location /ctusd/app/ { proxy_pass http://${CTUSD_APP}/; proxy_read_timeout 20s; }
  location /ctusd/indexer/ { proxy_pass http://${CTUSD_INDEXER}/; proxy_read_timeout 60s; }
  location /ctusd/metadata/ { proxy_pass http://${CTUSD_METADATA}/; proxy_read_timeout 20s; }
  location /usdc/app/ { proxy_pass http://${USDC_APP}/; proxy_read_timeout 20s; }
  location /usdc/indexer/ { proxy_pass http://${USDC_INDEXER}/; proxy_read_timeout 60s; }
  location /usdc/metadata/ { proxy_pass http://${USDC_METADATA}/; proxy_read_timeout 20s; }
  location = /recovery.html { try_files $uri =404; }
  location / { try_files $uri /index.html; }
}
