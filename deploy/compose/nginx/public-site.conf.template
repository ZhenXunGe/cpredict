map $uri $cpredict_cache_control {
  default "no-store";
  ~^/(demo/)?assets/ "public, max-age=31536000, immutable";
}
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
# The published port is loopback-only; the host edge replaces client-supplied
# forwarding headers. Direct local access has no forwarded address.
map $http_x_forwarded_for $cpredict_client_ip {
  "" $remote_addr;
  default $http_x_forwarded_for;
}
server {
  listen 8080;
  server_name _;
  server_tokens off;
  root /usr/share/nginx/html;
  index index.html;
  resolver 127.0.0.11 valid=10s ipv6=off;
  client_max_body_size 128k;
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types application/javascript application/json text/css image/svg+xml;
  add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
  add_header Cache-Control $cpredict_cache_control always;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  proxy_set_header X-Forwarded-For $cpredict_client_ip;
  proxy_set_header Authorization "";
  proxy_connect_timeout 3s;
  proxy_read_timeout 20s;
  proxy_send_timeout 20s;

  location = /healthz { access_log off; default_type application/json; return 200 '{"status":"ok"}'; }
  location = /readyz { allow 127.0.0.1; allow ::1; deny all; proxy_pass http://indexer:8787/readyz; }
  location ~ ^/(?:ctusd/|usdc/)?(?:app|indexer|metadata)/(?:metrics|readyz)(?:/|$) { return 404; }
  location ~ ^/(?:metrics|runtime|\.env|\.git)(?:/|$|\.) { return 404; }

  location = /site-config.json { try_files $uri =404; }
  location = /runtime-config.json { try_files $uri =404; }
  location /deployment/ { limit_except GET HEAD { deny all; } try_files $uri =404; }
  location /assets/ { try_files $uri =404; }
  location /demo/assets/ { try_files $uri =404; }
  location = /demo { return 308 /demo/; }
  location /demo/ { try_files $uri $uri/ /demo/index.html; }

  location /ctusd/app/ {
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $cpredict_client_ip;
    set $app_upstream app-service:8795;
    rewrite ^/ctusd/app/(.*)$ /$1 break;
    proxy_pass http://$app_upstream;
  }
  location /ctusd/indexer/ { proxy_pass http://indexer:8787/; }
  location /ctusd/metadata/ { proxy_pass http://metadata:8793/; }
  location /usdc/app/ {
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $cpredict_client_ip;
    set $app_usdc_upstream app-usdc:8795;
    rewrite ^/usdc/app/(.*)$ /$1 break;
    proxy_pass http://$app_usdc_upstream;
  }
  location /usdc/indexer/ {
    set $indexer_usdc_upstream indexer-usdc:8787;
    rewrite ^/usdc/indexer/(.*)$ /$1 break;
    proxy_pass http://$indexer_usdc_upstream;
  }
  location /usdc/metadata/ {
    set $metadata_usdc_upstream metadata-usdc:8793;
    rewrite ^/usdc/metadata/(.*)$ /$1 break;
    proxy_pass http://$metadata_usdc_upstream;
  }
  location /indexer/ {
    limit_except GET HEAD { deny all; }
    proxy_pass http://indexer:8787/;
    proxy_set_header Host $host;
    proxy_set_header Authorization "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 75s;
  }
  location /metadata/ { limit_except GET HEAD POST { deny all; } proxy_pass http://metadata:8793/; }
  location = /rpc {
    limit_except POST { deny all; }
    client_max_body_size 64k;
    set $rpc_upstream ${CPREDICT_RPC_UPSTREAM};
    rewrite ^ / break;
    proxy_pass $rpc_upstream;
    proxy_ssl_server_name on;
    proxy_ssl_name $proxy_host;
    proxy_set_header Host $proxy_host;
    proxy_set_header Content-Type application/json;
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-For "";
    proxy_hide_header Access-Control-Allow-Origin;
  }
  location /relay/ {
    limit_except POST { deny all; }
    set $relay_upstream permit2-relay:8792;
    rewrite ^/relay/(.*)$ /$1 break;
    proxy_pass http://$relay_upstream;
  }
  location = /recovery.html { try_files $uri =404; }
  location / { limit_except GET HEAD { deny all; } try_files $uri /index.html; }
}
