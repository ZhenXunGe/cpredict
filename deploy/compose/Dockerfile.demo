FROM node:22.23.2-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY patches ./patches
COPY manifests/sdk-declaration-patches.json ./manifests/sdk-declaration-patches.json
COPY scripts/public-site/apply-declaration-patches.mjs ./scripts/public-site/apply-declaration-patches.mjs
COPY scripts/public-site/package-notices.mjs ./scripts/public-site/package-notices.mjs
COPY scripts/sbom/npm-license-evidence.mjs ./scripts/sbom/npm-license-evidence.mjs
COPY manifests/npm-license-evidence.json ./manifests/npm-license-evidence.json
COPY manifests/npm-licenses ./manifests/npm-licenses
RUN npm ci --ignore-scripts
COPY examples ./examples
COPY offchain ./offchain
COPY generated ./generated
COPY deployments/arbitrum-sepolia/final-manifest.schema.json ./deployments/arbitrum-sepolia/final-manifest.schema.json
RUN npm run site:build

# Keep the image target and Compose service names compatible with existing hosts.
FROM nginxinc/nginx-unprivileged:1.31.5-alpine@sha256:2ddec616f1cb58bcac057aa388f28cb81e35137641ef4226d321714499329bd1 AS demo
ARG CPREDICT_IMAGE_REVISION
RUN printf '%s' "$CPREDICT_IMAGE_REVISION" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.revision="${CPREDICT_IMAGE_REVISION}"
USER root
RUN apk upgrade --no-cache
COPY --from=build /app/dist/user-site /usr/share/nginx/html
COPY deploy/compose/nginx/public-site.conf.template /etc/nginx/templates/default.conf.template
USER 101

FROM demo AS public-site
