FROM node:26.8.1-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts
COPY offchain ./offchain
COPY examples ./examples
COPY generated ./generated
RUN npm run build:offchain

FROM node:26.8.1-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS runtime-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev && npm cache clean --force

FROM node:26.8.1-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS indexer
ARG CPREDICT_IMAGE_REVISION
RUN printf '%s' "$CPREDICT_IMAGE_REVISION" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.revision="${CPREDICT_IMAGE_REVISION}"
ENV NODE_ENV=production
WORKDIR /app
RUN rm -rf /opt/yarn-v1.22.22 /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=runtime-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist/offchain/indexer ./dist/offchain/indexer
COPY --from=build --chown=node:node /app/dist/offchain/sdk ./dist/offchain/sdk
COPY package.json ./package.json
USER node
CMD ["node", "dist/offchain/indexer/src/main.js"]

