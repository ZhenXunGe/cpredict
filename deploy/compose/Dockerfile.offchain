FROM node:22.22.2-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts
COPY offchain ./offchain
COPY examples ./examples
COPY generated ./generated
RUN npm run build:offchain

FROM node:22.22.2-bookworm-slim AS runtime-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev && npm cache clean --force

FROM node:22.22.2-bookworm-slim AS indexer
ENV NODE_ENV=production
WORKDIR /app
COPY --from=runtime-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist/offchain/indexer ./dist/offchain/indexer
COPY package.json ./package.json
USER node
CMD ["node", "dist/offchain/indexer/src/main.js"]

FROM node:22.22.2-bookworm-slim AS paymaster
ENV NODE_ENV=production
WORKDIR /app
COPY --from=runtime-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist/offchain/paymaster-service ./dist/offchain/paymaster-service
COPY package.json ./package.json
USER node
CMD ["node", "dist/offchain/paymaster-service/src/main.js"]
