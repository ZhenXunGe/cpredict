{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpredict.example.invalid/schemas/release-bundle-v2.json",
  "title": "Cpredict deterministic release bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "tag",
    "tagObject",
    "commit",
    "sourceDateEpoch",
    "archive",
    "sourceManifestSha256",
    "requirementsManifestSha256",
    "releaseGatesSha256",
    "sbomSha256",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "project": { "const": "cpredict-protocol" },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "tagObject": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sourceDateEpoch": { "const": 0 },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "mode",
        "uid",
        "gid",
        "uname",
        "gname",
        "mtime",
        "checksumFile",
        "manifestFile"
      ],
      "properties": {
        "format": { "const": "ustar+gzip" },
        "mode": { "const": "0644" },
        "uid": { "const": 0 },
        "gid": { "const": 0 },
        "uname": { "const": "root" },
        "gname": { "const": "root" },
        "mtime": { "const": 0 },
        "checksumFile": { "const": "SHA256SUMS" },
        "manifestFile": { "const": "RELEASE-BUNDLE.json" }
      }
    },
    "sourceManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requirementsManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "releaseGatesSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sbomSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[ -~]+$"
          },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
