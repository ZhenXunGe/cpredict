{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpredict.example/schemas/arbitrum-sepolia-source-verification-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceClass", "chainId", "status", "generatedAt", "sourceCommit", "sourceManifestSha256", "inputSha256", "contracts"],
  "properties": {
    "schemaVersion": { "const": "cpredict.arbitrum-sepolia.source-verification.v1" },
    "evidenceClass": { "const": "ARBITRUM_SEPOLIA_RUNTIME" },
    "chainId": { "const": 421614 },
    "status": { "enum": ["COMPLETE", "FAILED"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceManifestSha256": { "$ref": "#/$defs/sha256" },
    "inputSha256": { "$ref": "#/$defs/sha256" },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "address", "status", "constructorArgsVerified", "runtimeBytecodeVerified", "startedAt", "finishedAt", "source", "sourceCommit", "compiler", "optimizerRuns", "viaIR", "evmVersion", "constructorArgsSha256", "runtimeCodehash", "commandSummary", "exitCode", "submissionGuid", "explorerUrl", "logFile", "logSha256"],
      "properties": {
        "contract": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "status": { "enum": ["VERIFIED", "FAILED"] },
        "constructorArgsVerified": { "type": "boolean" },
        "runtimeBytecodeVerified": { "type": "boolean" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 3 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "compiler": { "const": "0.8.36" },
        "optimizerRuns": { "type": "integer", "minimum": 1 },
        "viaIR": { "const": true },
        "evmVersion": { "type": "string", "minLength": 1 },
        "constructorArgsSha256": { "$ref": "#/$defs/sha256" },
        "runtimeCodehash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
        "commandSummary": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer" },
        "submissionGuid": { "type": ["string", "null"] },
        "explorerUrl": { "type": "string", "format": "uri" },
        "logFile": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.log$" },
        "logSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
