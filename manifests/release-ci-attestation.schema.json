{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpredict.example.invalid/schemas/release-ci-attestation-v2.json",
  "title": "Cpredict same-SHA release gate attestation predicate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "commitSha",
    "sourceManifestSha256",
    "workflow",
    "gates"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "repository": { "const": "ZhenXunGe/cpredict" },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "ref", "sha", "event", "job", "runId", "runAttempt"],
      "properties": {
        "path": { "const": ".github/workflows/release-audit.yml" },
        "ref": { "const": "refs/heads/main" },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "event": { "const": "workflow_dispatch" },
        "job": { "const": "attest-release-gates" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "resultPath", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "resultPath": {
            "type": "string",
            "pattern": "^reports/release/gates/[a-z][a-z0-9-]*\\.json$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
