ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL_A=
ARBITRUM_SEPOLIA_RPC_URL_B=
# Optional Vite development-server proxy target. HTTPS origin only; never include credentials.
# This is server-side configuration and intentionally does not use the browser-exposed VITE_ prefix.
CPREDICT_DEMO_REMOTE_ORIGIN=
ARBISCAN_API_KEY=
CPREDICT_DEPLOYMENT_PROFILE=formal
CPREDICT_AUDIT_TAG=
DEPLOYER_PRIVATE_KEY=
DEPLOYER_MIN_BALANCE_WEI=20000000000000000
GOVERNANCE_SAFE=
EMERGENCY_SAFE=
PROTOCOL_TREASURY=
SPONSOR_SIGNER=
EXPECTED_FACTORY_DEPENDENCY_FINGERPRINT=
PAYMASTER_MAX_COST_PER_OP=2000000000000000
PAYMASTER_MAX_COST_PER_USER_DAY=20000000000000000
PAYMASTER_MAX_COST_GLOBAL_DAY=500000000000000000
CPREDICT_DEPLOYMENT_ACKNOWLEDGEMENT=

# Wildcard bind is rejected unless this is explicitly true. Use true only inside the Compose network.
CPREDICT_INDEXER_CONTAINER_MODE=false

# Optional on the legacy Demo; required by the public smart-account site for
# EOA / ERC-1271 / ERC-6492 rule signatures. Server-side RPC only.
# CPREDICT_METADATA_RPC_URL=https://your-arbitrum-sepolia-rpc.example
#
# Public user site: each environment has a separate file, database/schema and provider project.
# Values below are server-only; never expose provider credentials in VITE_* or site-config.json.
# CPREDICT_APP_CONFIG_FILE=/absolute/path/to/ctusd-runtime.json
# CPREDICT_APP_DATABASE_URL=postgresql://user:password@localhost:5432/cpredict_ctusd
# Full chain RPC, including fixed-block eth_getStorageAt; validate independently of the AA endpoints.
# CPREDICT_APP_RPC_URL=https://your-arbitrum-sepolia-rpc.example
# CPREDICT_APP_METADATA_URL=http://127.0.0.1:8790
# CPREDICT_APP_PRIVY_SECRET=replace-via-secret-store
# The same official ZeroDev RPC can fill both; its project and chain must match the runtime file.
# CPREDICT_APP_ZERODEV_BUNDLER_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT_ID/chain/421614
# CPREDICT_APP_ZERODEV_PAYMASTER_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT_ID/chain/421614
# Optional server-only read credentials; configure both together in each environment's private env file.
# Management reads are fixed GET methods. Supplying credentials does not verify billing or sponsorship policies.
# CPREDICT_APP_ZERODEV_MANAGEMENT_API_KEY=YOUR_SERVER_ONLY_MANAGEMENT_KEY
# CPREDICT_APP_ZERODEV_TEAM_ID=YOUR_ZERODEV_TEAM_ID
# CPREDICT_APP_HOST=127.0.0.1
# CPREDICT_APP_CONTAINER_MODE=false
# CPREDICT_APP_PORT=8795
# CPREDICT_MAINTENANCE_DATABASE_URL=postgresql://user:password@localhost:5432/cpredict_ctusd
# CPREDICT_MAINTENANCE_RPC_URL=https://your-arbitrum-sepolia-rpc.example
# CPREDICT_METADATA_TRUSTED_PROXIES=127.0.0.1
# CPREDICT_INDEXER_PUBLIC_CONFIG_FILE=/absolute/path/to/ctusd-runtime.json
# CPREDICT_INDEXER_METADATA_URL=https://metadata-for-this-environment.example
# The ctUSD app shares the existing indexer database; USDC uses its independent database.
# Public indexer CORE_ADDRESSES must be exactly Factory, Marketplace, FeeVault and BondEscrow.
# Do not add the payment token or EntryPoint to the global CORE_ADDRESSES log scan.
#
# Paymaster HTTP service. The adapter module injects production auth, account decoding,
# durable budget storage and KMS/HSM signing; never put a raw signer private key here.
CPREDICT_PAYMASTER_HOST=127.0.0.1
CPREDICT_PAYMASTER_CONTAINER_MODE=false
CPREDICT_PAYMASTER_PORT=3001
CPREDICT_PAYMASTER_LOG_LEVEL=info
CPREDICT_PAYMASTER_ADAPTER_MODULE=file:///absolute/path/to/deployment-paymaster-adapters.js
CPREDICT_PAYMASTER_CHAIN_ID=421614
CPREDICT_PAYMASTER_ENTRY_POINT=0x1111111111111111111111111111111111111111
CPREDICT_PAYMASTER_ADDRESS=0x2222222222222222222222222222222222222222
CPREDICT_PAYMASTER_EXPECTED_SIGNER=0x3333333333333333333333333333333333333333
CPREDICT_PAYMASTER_POLICY_VERSION=1
CPREDICT_PAYMASTER_VERIFICATION_GAS_LIMIT=150000
CPREDICT_PAYMASTER_POST_OP_GAS_LIMIT=100000
CPREDICT_PAYMASTER_VALIDITY_SECONDS=300
CPREDICT_PAYMASTER_MAX_COST_PER_REQUEST=10000000000000000
CPREDICT_PAYMASTER_MAX_COST_PER_USER_DAY=20000000000000000
CPREDICT_PAYMASTER_MAX_COST_GLOBAL_DAY=500000000000000000
CPREDICT_PAYMASTER_MAX_INIT_CODE_BYTES=1024
CPREDICT_PAYMASTER_MAX_CALL_DATA_BYTES=16384
CPREDICT_PAYMASTER_MIN_SPONSORED_LISTING_UNITS=1000000
CPREDICT_PAYMASTER_MAX_CREATE_LISTINGS_PER_USER_DAY=20
CPREDICT_PAYMASTER_MAX_CANCEL_LISTINGS_PER_USER_DAY=40
