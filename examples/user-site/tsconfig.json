{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "rootDir": "../..",
    "moduleResolution": "Bundler",
    "declaration": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": []
}
